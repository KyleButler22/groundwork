{
  "name": "groundwork",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:recipes": "node scripts/generate-recipes.mjs",
    "verify:sql": "node scripts/verify-sql.mjs && node scripts/verify-movement-graph.mjs && node scripts/verify-food-reference.mjs && node scripts/verify-recipes.mjs",
    "verify": "npm run typecheck && npm run verify:sql && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dexie": "^4.4.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
